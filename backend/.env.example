# SecOps Production Environment Configuration Template

# General Settings
PROJECT_NAME="AI-Powered Automated Incident Response System (SecOps)"
SECRET_KEY="SECURE_SECOPS_SECRET_KEY_CHANGE_IN_PRODUCTION_9823471982"
ALGORITHM="HS256"

# Database Configuration (PostgreSQL vs SQLite)
USE_POSTGRES=true
POSTGRES_SERVER=localhost
POSTGRES_USER=secops
POSTGRES_PASSWORD=secops_password123
POSTGRES_DB=secops_db
POSTGRES_PORT=5432

# AI Engine Configuration
# Options: "smart_local" (default local rules), "ollama" (offline LLaMA 3), "openai" (Cloud LLM)
AI_ENGINE_MODE=smart_local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Cloud OpenAI Fallback (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Threshold Tuning
FAILED_LOGIN_THRESHOLD=5
TIME_WINDOW_SECONDS=60
AUTO_BLOCK_RISK_THRESHOLD=80
